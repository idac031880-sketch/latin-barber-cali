# Copia estas variables a tu terminal (export ...) antes de correr el servidor,
# o a un .env si luego agregas un cargador de .env. Ninguna es obligatoria:
# sin ellas, el sitio y las reservas funcionan igual, solo sin Google Calendar.

# Puerto del servidor (opcional, por defecto 8890)
PORT=8890

# Usuario/contraseña fijos de la intranet (opcional; si no los defines,
# el servidor genera una contraseña aleatoria la primera vez que corre)
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Google Calendar (opcional) ---
# 1. Corre primero: python3 server/authorize_calendar.py  (instrucciones dentro del archivo)
# 2. Luego define estas variables antes de iniciar server/app.py:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendario del negocio: todas las citas se registran aquí.
# Puede ser "primary" (el calendario principal de la cuenta que autorizó)
# o el ID de un calendario específico (Ajustes del calendario > Integrar calendario).
GOOGLE_CALENDAR_ID=primary

# Un calendario por barbero: "Nombre=id_de_su_calendario,Nombre2=id2"
# Cada barbero debe compartir su calendario (permiso "Hacer cambios en los eventos")
# con la cuenta de Google que ejecutó authorize_calendar.py.
GOOGLE_BARBER_CALENDARS=
